{
  "name": "ape-invitational-almanac",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs && node scripts/configure-publication-build.mjs",
    "build:pages": "npm run build && node scripts/prepare-github-pages.mjs",
    "build:moose": "node scripts/build-mooseys-mommy.mjs",
    "build:johnny": "node scripts/build-johnnys-jerks.mjs",
    "dev:johnny": "vite --config vite.johnny.config.ts",
    "pipeline:johnny": "python -m sleeper_work.capture_craig_redraft && python -m sleeper_work.build_redraft_recap_payload",
    "refresh:johnny": "npm run pipeline:johnny && npm run build:johnny",
    "draft:api": "python -m draft_assistant",
    "draft:web": "vite --host 127.0.0.1 --port 4173",
    "draft:check": "python -m unittest discover -s tests -p test_draft_assistant.py"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@fontsource/roboto": "5.2.10",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@tanstack/react-query": "^5.102.8",
    "@use-gesture/react": "10.3.1",
    "html2canvas": "^1.4.1",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
